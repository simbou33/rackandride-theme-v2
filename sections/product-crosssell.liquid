{% comment %}
  Cross-sell strip for the foot of a product page: what else belongs on the
  same wall.

  It deliberately skips the product's material siblings. Those are the same
  design in another wood, they already have their own selector higher up the
  page, and offering them again here as something to "complete your setup"
  with would be inviting the shopper to buy the same object twice.

  Products come from the same category as the product, resolved by the shared
  `parent-collection` snippet so this strip and the breadcrumb can never
  disagree about what the parent is.

  Renders nothing when no parent collection resolves or when nothing survives
  the exclusions, so a lone product in its category shows no empty heading.
{% endcomment %}

{% capture parent_handle %}{% render 'parent-collection', product: product %}{% endcapture %}
{% liquid
  assign parent_handle = parent_handle | strip
  assign parent = collections[parent_handle]

  # Comma-fenced handles rather than an array: `concat` returns nil on arrays
  # of product drops, the same trap the material selector works around.
  assign skip = ',' | append: product.handle | append: ','
  for sib in product.metafields.custom.material_siblings.value
    if sib.handle != blank
      assign skip = skip | append: sib.handle | append: ','
    endif
  endfor

  assign limit = section.settings.products_to_show
%}

{% if parent %}
  {% capture cards %}
    {% assign shown = 0 %}
    {% for candidate in parent.products %}
      {% assign key = ',' | append: candidate.handle | append: ',' %}
      {% unless skip contains key %}
        {% if shown < limit %}
          {% assign shown = shown | plus: 1 %}
          {% assign card_alt = candidate.featured_media.preview_image.alt | default: candidate.title %}
          <li class="crosssell__item">
            <a class="crosssell__card" href="{{ candidate.url }}">
              <span class="crosssell__media">
                {% if candidate.featured_media %}
                  {{
                    candidate.featured_media.preview_image
                    | image_url: width: 600
                    | image_tag:
                      widths: '200, 300, 450, 600',
                      sizes: '(min-width: 990px) 22vw, 62vw',
                      loading: 'lazy',
                      class: 'crosssell__image',
                      alt: card_alt
                  }}
                {% endif %}
              </span>
              <span class="crosssell__title">{{ candidate.title }}</span>
              <span class="crosssell__price">{{ candidate.price | money }}</span>
            </a>
          </li>
        {% endif %}
      {% endunless %}
    {% endfor %}
  {% endcapture %}

  {% if cards != blank %}
    <section class="crosssell">
      <h2 class="crosssell__heading">{{ 'product.crosssell.title' | t }}</h2>
      <ul class="crosssell__list" role="list">{{ cards }}</ul>
    </section>
  {% endif %}
{% endif %}

{% stylesheet %}
  .crosssell {
    max-width: var(--rar-page-width);
    margin: 0 auto;
    padding: 3rem var(--rar-page-margin) 4rem;
    border-top: 1px solid rgb(28 40 48 / 10%);
  }
  .crosssell__heading {
    margin: 0 0 1.5rem;
    font-size: 1.5rem;
  }

  /* One row that scrolls sideways on a phone rather than a grid that pushes
     the page down: this sits at the foot of a long page, and a shopper who
     has read that far should be able to glance across it, not scroll past it
     a second time. */
  .crosssell__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 62%;
    gap: 1rem;
    margin: 0;
    padding: 0 var(--rar-page-margin) 0.5rem;
    margin-inline: calc(-1 * var(--rar-page-margin));
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }
  .crosssell__item {
    scroll-snap-align: start;
    min-width: 0;
  }
  .crosssell__card {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .crosssell__media {
    display: block;
    aspect-ratio: 4 / 5;
    margin-bottom: 0.7rem;
    border-radius: var(--rar-radius-card);
    overflow: hidden;
    background-color: var(--rar-color-surface);
  }
  .crosssell__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .crosssell__card:hover .crosssell__image {
    transform: scale(1.03);
  }
  .crosssell__title {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.35;
  }
  .crosssell__price {
    display: block;
    color: var(--rar-price);
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @media screen and (min-width: 750px) {
    .crosssell__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-columns: auto;
      gap: 1.5rem 1.25rem;
      margin-inline: 0;
      padding-inline: 0;
      overflow-x: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.crosssell",
  "settings": [
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [{ "name": "t:general.crosssell" }]
}
{% endschema %}
