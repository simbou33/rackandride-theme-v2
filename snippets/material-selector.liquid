{% doc %}
  Renders the material selector panel: the other product pages that share this
  design in a different material.

  Families are declared per product in `custom.material_siblings`. Shopify has
  no reverse lookup on reference metafields, so the panel unions the current
  product's list with each sibling's own list. One fully-filled "hub" member is
  therefore enough for every page of the family to show the complete set, and a
  forgotten entry shortens the list instead of breaking the page.

  The union is built as an ordered list of handles rather than an array of
  products: Liquid's `concat` returns nil on arrays of product drops, so the
  two hops are walked in place and deduplicated through a comma-fenced string.

  Materials are ordered by range and never by price — plywood, bamboo, oak,
  black oak — then anything else in the order it was added to the metafield, so
  a future material needs no code change. A member that no longer resolves
  (deleted, unpublished, off the Online Store) comes back blank and is skipped.

  @param {object} current - The product being viewed
  @param {object} siblings - The current product's `custom.material_siblings` list

  @example
  {% render 'material-selector', current: product, siblings: mat_sibs %}
{% enddoc %}

{% liquid
  assign order = 'plywood,bamboo,oak,black_oak' | split: ','
  assign seen = ','
  assign handles = ''

  # One pass per known range, current product included so it lands in its own
  # bucket rather than always first.
  for g in order
    assign key = ',' | append: current.handle | append: ','
    unless seen contains key
      assign grade = current.metafields.custom.material_grade.value | downcase | strip
      if grade == g
        assign handles = handles | append: current.handle | append: ','
        assign seen = seen | append: current.handle | append: ','
      endif
    endunless

    for sib in siblings
      if sib.handle != blank
        assign key = ',' | append: sib.handle | append: ','
        unless seen contains key
          assign grade = sib.metafields.custom.material_grade.value | downcase | strip
          if grade == g
            assign handles = handles | append: sib.handle | append: ','
            assign seen = seen | append: sib.handle | append: ','
          endif
        endunless
      endif

      for hop in sib.metafields.custom.material_siblings.value
        if hop.handle != blank
          assign key = ',' | append: hop.handle | append: ','
          unless seen contains key
            assign grade = hop.metafields.custom.material_grade.value | downcase | strip
            if grade == g
              assign handles = handles | append: hop.handle | append: ','
              assign seen = seen | append: hop.handle | append: ','
            endif
          endunless
        endif
      endfor
    endfor
  endfor

  # Anything outside the fixed order keeps the order it was added in.
  assign key = ',' | append: current.handle | append: ','
  unless seen contains key
    assign handles = handles | append: current.handle | append: ','
    assign seen = seen | append: current.handle | append: ','
  endunless
  for sib in siblings
    if sib.handle != blank
      assign key = ',' | append: sib.handle | append: ','
      unless seen contains key
        assign handles = handles | append: sib.handle | append: ','
        assign seen = seen | append: sib.handle | append: ','
      endunless
    endif
    for hop in sib.metafields.custom.material_siblings.value
      if hop.handle != blank
        assign key = ',' | append: hop.handle | append: ','
        unless seen contains key
          assign handles = handles | append: hop.handle | append: ','
          assign seen = seen | append: hop.handle | append: ','
        endunless
      endif
    endfor
  endfor

  assign family = handles | split: ','
%}

<div class="product__material">
  <button type="button" class="matsel__trigger" data-material-open aria-haspopup="dialog">
    {% render 'material-badge', product: current %}

    {%- comment -%}
      Thumbnails of the other materials, as on the reference: they say "this
      exists in other woods" before the label has to. Capped at three so the
      row stays a control rather than a gallery.
    {%- endcomment -%}
    <span class="matsel__thumbs" aria-hidden="true">
      {%- assign thumb_count = 0 -%}
      {%- for handle in family -%}
        {%- if handle == current.handle -%}{%- continue -%}{%- endif -%}
        {%- if thumb_count >= 3 -%}{%- break -%}{%- endif -%}
        {%- liquid
          assign thumb = nil
          for sib in siblings
            if sib.handle == handle
              assign thumb = sib
              break
            endif
            for hop in sib.metafields.custom.material_siblings.value
              if hop.handle == handle
                assign thumb = hop
                break
              endif
            endfor
            if thumb
              break
            endif
          endfor
        -%}
        {%- if thumb.featured_media -%}
          {%- assign thumb_count = thumb_count | plus: 1 -%}
          <span class="matsel__thumb">
            {{
              thumb.featured_media.preview_image
              | image_url: width: 120
              | image_tag: widths: '60, 90, 120', sizes: '34px', loading: 'lazy', class: 'matsel__thumb-img', alt: ''
            }}
          </span>
        {%- endif -%}
      {%- endfor -%}
    </span>

    <svg class="matsel__chevron" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false"><path d="M7 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<material-selector class="matsel">
  <dialog class="matsel__dialog" scroll-lock aria-label="{{ 'product.selector.title' | t }}">
    <div class="matsel__panel">
      <span class="matsel__grab" aria-hidden="true"></span>

      <header class="matsel__header">
        <h2 class="matsel__title">{{ 'product.selector.title' | t }}</h2>
        <button
          type="button"
          class="matsel__close"
          data-material-close
          aria-label="{{ 'product.selector.close' | t }}"
        >
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
      </header>

      <ul class="matsel__list" role="list">
        {%- for handle in family -%}
          {%- liquid
            # Resolve the handle back to the drop it came from. Families hold a
            # handful of products, so a scan is cheaper than a storefront lookup.
            assign item = current
            assign found = false
            if handle == current.handle
              assign found = true
            endif
            unless found
              for sib in siblings
                if sib.handle == handle
                  assign item = sib
                  assign found = true
                  break
                endif
                for hop in sib.metafields.custom.material_siblings.value
                  if hop.handle == handle
                    assign item = hop
                    assign found = true
                    break
                  endif
                endfor
                if found
                  break
                endif
              endfor
            endunless

            assign is_current = false
            if handle == current.handle
              assign is_current = true
            endif

            assign grade = item.metafields.custom.material_grade.value | downcase | strip
            assign label = item.title
            if grade != blank
              assign label_key = 'product.material.' | append: grade
              assign label = label_key | t
            endif
          -%}

          {%- if found -%}
            <li class="matsel__item">
              {%- if is_current -%}
                <div class="matsel__row matsel__row--current" aria-current="true">
              {%- else -%}
                <a class="matsel__row matsel__row--link" href="{{ item.url }}">
              {%- endif -%}

              <span class="matsel__media">
                {%- if item.featured_media -%}
                  {{
                    item.featured_media.preview_image
                    | image_url: width: 240
                    | image_tag: widths: '120, 180, 240', sizes: '72px', loading: 'lazy', class: 'matsel__img', alt: ''
                  }}
                {%- endif -%}
              </span>

              <span class="matsel__body">
                <span class="matsel__name">{{ label }}</span>
                <span class="matsel__price">{{ item.price | money }}</span>
              </span>

              {%- if is_current -%}
                <span class="matsel__state">{{ 'product.selector.selected' | t }}</span>
                </div>
              {%- else -%}
                <svg class="matsel__go" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M7 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </dialog>
</material-selector>

{% stylesheet %}
  /* Side drawer on desktop, bottom sheet on touch: a 460px side panel is
     awkward to reach on a phone. Scroll locking is handled theme-wide by the
     `scroll-lock` attribute (assets/critical.css). */
  .matsel__dialog {
    position: fixed;
    z-index: 100;
    inset: auto 0 0 0;
    width: 100%;
    max-width: 100vw;
    max-height: 85dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-start-start-radius: var(--rar-radius-card);
    border-start-end-radius: var(--rar-radius-card);
    background-color: var(--rar-color-background);
    color: var(--rar-text);
    box-shadow: 0 -8px 40px rgb(28 40 48 / 14%);
    transform: translateY(0);
    transition:
      transform 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      overlay 0.32s allow-discrete,
      display 0.32s allow-discrete;
  }
  .matsel__dialog:not([open]) {
    transform: translateY(100%);
  }
  @starting-style {
    .matsel__dialog[open] {
      transform: translateY(100%);
    }
  }
  .matsel__dialog::backdrop {
    background-color: rgb(28 40 48 / 0%);
    transition:
      background-color 0.32s ease,
      overlay 0.32s allow-discrete,
      display 0.32s allow-discrete;
  }
  .matsel__dialog[open]::backdrop {
    background-color: rgb(28 40 48 / 45%);
  }
  @starting-style {
    .matsel__dialog[open]::backdrop {
      background-color: rgb(28 40 48 / 0%);
    }
  }

  /* Trigger: the pill keeps stating the current material, the thumbnails say
     the design exists in others, and the whole row is one tap target. */
  .matsel__trigger {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    min-height: 52px;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgb(28 40 48 / 12%);
    border-radius: var(--rar-radius-card);
    background-color: var(--rar-color-surface);
    color: inherit;
    font-family: inherit;
    cursor: pointer;
    text-align: start;
  }
  .matsel__trigger:hover {
    border-color: rgb(28 40 48 / 26%);
  }
  .matsel__trigger:focus-visible {
    outline: 2px solid var(--rar-accent);
    outline-offset: 2px;
  }
  .matsel__thumbs {
    display: flex;
    gap: 0.25rem;
    margin-inline-start: auto;
  }
  .matsel__thumb {
    display: block;
    width: 34px;
    height: 34px;
    overflow: hidden;
    border: 1px solid rgb(28 40 48 / 12%);
    border-radius: 6px;
    background-color: var(--rar-color-background);
  }
  .matsel__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .matsel__chevron {
    flex: 0 0 auto;
    color: rgb(28 40 48 / 45%);
  }

  .matsel__panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .matsel__grab {
    display: block;
    width: 2.25rem;
    height: 4px;
    margin: 0.6rem auto 0;
    border-radius: 999px;
    background-color: rgb(28 40 48 / 18%);
  }
  .matsel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem 0.75rem;
  }
  .matsel__title {
    margin: 0;
    font-size: 1.125rem;
  }
  .matsel__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-inline-end: -0.6rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .matsel__close:focus-visible {
    outline: 2px solid var(--rar-accent);
    outline-offset: -2px;
  }

  .matsel__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0 1.25rem 1.5rem;
    overflow-y: auto;
    list-style: none;
  }
  .matsel__item {
    margin: 0;
  }
  .matsel__row {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem;
    border: 1px solid rgb(28 40 48 / 10%);
    border-radius: var(--rar-radius-card);
    color: inherit;
    text-decoration: none;
  }
  .matsel__row--current {
    border-color: var(--rar-mat-oak);
    background-color: var(--rar-color-surface);
  }
  .matsel__row--link:hover {
    border-color: rgb(28 40 48 / 28%);
  }
  .matsel__row--link:focus-visible {
    outline: 2px solid var(--rar-accent);
    outline-offset: 2px;
  }
  .matsel__media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background-color: var(--rar-color-surface);
  }
  .matsel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .matsel__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .matsel__name {
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .matsel__price {
    color: var(--rar-price);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .matsel__state {
    color: var(--rar-mat-oak);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .matsel__go {
    color: rgb(28 40 48 / 40%);
  }

  @media screen and (min-width: 750px) {
    .matsel__dialog {
      inset: 0 0 0 auto;
      width: min(460px, 100vw);
      height: 100dvh;
      max-height: 100dvh;
      border-radius: 0;
      box-shadow: -8px 0 40px rgb(28 40 48 / 12%);
      transform: translateX(0);
    }
    .matsel__dialog:not([open]) {
      transform: translateX(100%);
    }
    @starting-style {
      .matsel__dialog[open] {
        transform: translateX(100%);
      }
    }
    .matsel__grab {
      display: none;
    }
    .matsel__header {
      padding-top: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .matsel__dialog,
    .matsel__dialog::backdrop {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class MaterialSelector extends HTMLElement {
    connectedCallback() {
      this.dialog = this.querySelector('dialog');
      if (!this.dialog) return;

      this.addEventListener('click', (event) => {
        if (event.target.closest('[data-material-close]')) this.close();
      });

      // A click on the backdrop resolves to the dialog element itself.
      this.dialog.addEventListener('click', (event) => {
        if (event.target === this.dialog) this.close();
      });

      if (!MaterialSelector.bound) {
        MaterialSelector.bound = true;
        document.addEventListener('click', (event) => {
          if (!event.target.closest('[data-material-open]')) return;
          const selector = document.querySelector('material-selector');
          if (selector) selector.open();
        });
      }
    }

    open() {
      if (this.dialog && !this.dialog.open) this.dialog.showModal();
    }

    close() {
      if (this.dialog && this.dialog.open) this.dialog.close();
    }
  }

  if (!customElements.get('material-selector')) {
    customElements.define('material-selector', MaterialSelector);
  }
{% endjavascript %}
