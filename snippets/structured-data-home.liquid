{% doc %}
  Renders the home page JSON-LD: Organization (the brand behind the shop) and
  WebSite (the site name Google shows in results), linked by their @id.

  The WebSite node follows the storefront language: its URL is the localized
  home and its description the translated home meta description. No
  SearchAction: Google retired the sitelinks search box.

  @example
  {% render 'structured-data-home' %}
{% enddoc %}

{%- liquid
  assign org_id = shop.url | append: '/#organization'
  assign site_id = shop.url | append: '/#website'
  assign home_url = shop.url | append: routes.root_url
  assign logo_url = 'logo-wordmark.png' | asset_url | prepend: 'https:'
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": {{ org_id | json }},
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "logo": {
          "@type": "ImageObject",
          "url": {{ logo_url | json }},
          "width": 2717,
          "height": 2717
        },
        "email": {{ shop.email | json }},
        "address": {
          "@type": "PostalAddress",
          "addressRegion": "Gironde",
          "addressCountry": "FR"
        }
      },
      {
        "@type": "WebSite",
        "@id": {{ site_id | json }},
        "name": {{ shop.name | json }},
        "url": {{ home_url | json }},
        "description": {{ 'general.meta.home_description' | t | json }},
        "inLanguage": {{ request.locale.iso_code | json }},
        "publisher": { "@id": {{ org_id | json }} }
      }
    ]
  }
</script>
