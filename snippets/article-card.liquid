{% doc %}
  Renders a blog article card: image, optional pillar badge, title, excerpt,
  and a meta line (date · author · estimated read time).
  Reused by the blog list grid and the "related articles" block on articles.

  Reading time is estimated at 200 words/min from the article body.

  @param {object} card_article - The article to render
  @param {string} [sizes] - The responsive `sizes` attribute
  @param {string} [p1] - Pillar 1 tag value (maps to the "practical" label)
  @param {string} [p2] - Pillar 2 tag value (maps to the "deco" label)
  @param {string} [p3] - Pillar 3 tag value (maps to the "brand" label)

  @example
  {% render 'article-card', card_article: article, p1: 'Pratique', p2: 'Déco', p3: 'Marque' %}
{% enddoc %}

{% liquid
  assign words = card_article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200
  if minutes < 1
    assign minutes = 1
  endif

  assign pillar_label = ''
  for tag in card_article.tags
    if p1 != blank and tag == p1
      assign pillar_label = 'blog.pillar.practical' | t
    elsif p2 != blank and tag == p2
      assign pillar_label = 'blog.pillar.deco' | t
    elsif p3 != blank and tag == p3
      assign pillar_label = 'blog.pillar.brand' | t
    endif
  endfor

  assign excerpt = card_article.excerpt
  if excerpt == blank
    assign excerpt = card_article.content
  endif
  assign pub_date = card_article.published_at | date: '%-d %B %Y'

  # A `| default:` inside an image_tag argument list ends the list: every named
  # argument after it is swallowed by the filter. Resolve the values first.
  assign card_sizes = sizes | default: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
  assign card_alt = card_article.image.alt | default: card_article.title
%}

<a class="article-card" href="{{ card_article.url }}">
  <div class="article-card__media">
    {% if card_article.image %}
      {{
        card_article.image
        | image_url: width: 800
        | image_tag:
          widths: '300, 400, 500, 600, 800',
          sizes: card_sizes,
          loading: 'lazy',
          class: 'article-card__image',
          alt: card_alt
      }}
    {% else %}
      {{ 'image' | placeholder_svg_tag: 'article-card__image article-card__image--placeholder' }}
    {% endif %}
    {% if pillar_label != blank %}
      <span class="article-card__pillar">{{ pillar_label }}</span>
    {% endif %}
  </div>

  <div class="article-card__body">
    <h3 class="article-card__title">{{ card_article.title }}</h3>
    {% if excerpt != blank %}
      <p class="article-card__excerpt">{{ excerpt | strip_html | truncate: 120 }}</p>
    {% endif %}
    <p class="article-card__meta">
      {{ 'blog.article_metadata_html' | t: date: pub_date, author: card_article.author }}
      <span class="article-card__dot" aria-hidden="true">·</span>
      {{ 'blog.read_time_html' | t: minutes: minutes }}
    </p>
  </div>
</a>

{% stylesheet %}
  .article-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }
  .article-card__media {
    position: relative;
    aspect-ratio: 3 / 2;
    margin-bottom: 0.95rem;
    border-radius: var(--rar-radius-card);
    overflow: hidden;
    background-color: var(--rar-color-surface);
  }
  .article-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .article-card:hover .article-card__image {
    transform: scale(1.03);
  }
  .article-card__image--placeholder {
    opacity: 0.35;
  }
  .article-card__pillar {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background-color: var(--rar-color-background);
    color: var(--rar-text);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .article-card__title {
    margin: 0 0 0.45rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .article-card:hover .article-card__title {
    color: var(--rar-accent);
  }
  .article-card__excerpt {
    margin: 0 0 0.65rem;
    color: rgb(28 40 48 / 70%);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .article-card__meta {
    margin: 0;
    color: rgb(28 40 48 / 55%);
    font-size: 0.8125rem;
  }
  .article-card__dot {
    margin-inline: 0.25rem;
  }
{% endstylesheet %}
