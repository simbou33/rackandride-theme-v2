{% doc %}
  Rating badge: stars + "4.6/5 · 126 reviews on Etsy".

  Without parameters it shows the SHOP's Etsy rating, read from the theme
  settings (Theme settings > Reviews) so it can be kept in step with Etsy
  without touching code. That rating comes from another site, so it carries no
  structured data: Google forbids marking up reviews aggregated from other
  websites. Renders nothing when no rating is set.

  The product page passes its own rating instead (see `product-rating`), with a
  ready-made `label`.

  @param {string} [value] - Average rating out of 5 (default: theme setting)
  @param {string} [count] - Number of reviews (default: theme setting)
  @param {string} [source] - Source name (default: Etsy)
  @param {string} [label] - Text after the score, replaces "N reviews on Etsy"
  @param {string} [url] - Link to the reviews: external opens in a new tab
  @param {string} [class] - Optional extra class

  @example
  {% render 'shop-rating' %}
  {% render 'shop-rating', value: '4.8', label: '12 reviews', url: '#product-reviews' %}
{% enddoc %}

{%- liquid
  assign own_value = value | default: ''
  assign v = own_value | default: settings.etsy_rating_value | default: '' | strip
  assign c = count | default: settings.etsy_rating_count
  assign src = source | default: 'Etsy'
  assign text = label | default: ''
  assign link = url | default: ''
  if own_value == ''
    assign link = link | default: settings.etsy_rating_url | default: ''
  endif
  assign external = false
  if link contains '://'
    assign external = true
  endif
  assign v_num = v | replace: ',', '.'
  assign pct = v_num | times: 20
  assign decimal_separator = 'general.decimal_separator' | t
  assign v_display = v_num | replace: '.', decimal_separator
-%}

{%- if v != blank -%}
  {%- capture stars -%}{% for i in (1..5) %}<svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><path d="M10 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4L2.2 7.7l5.4-.8z"/></svg>{% endfor %}{%- endcapture -%}
  {%- if link != blank -%}
    <a class="shop-rating {{ class }}" href="{{ link }}"{% if external %} target="_blank" rel="noopener nofollow"{% endif %}>
  {%- else -%}
    <span class="shop-rating {{ class }}">
  {%- endif -%}
    <span class="shop-rating__stars" aria-hidden="true">
      <span class="shop-rating__bg">{{ stars }}</span>
      <span class="shop-rating__fg" style="width: {{ pct }}%">{{ stars }}</span>
    </span>
    <span class="shop-rating__text"><strong>{{ v_display }}/5</strong> · {% if text != blank %}{{ text }}{% else %}{{ 'general.reviews_count' | t: count: c, source: src }}{% endif %}</span>
  {%- if link != blank -%}</a>{%- else -%}</span>{%- endif -%}
{%- endif -%}

{% stylesheet %}
  .shop-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--rar-text);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .shop-rating__stars {
    position: relative;
    display: inline-flex;
    line-height: 0;
  }
  .shop-rating__bg {
    display: inline-flex;
    gap: 0.06rem;
  }
  .shop-rating__bg svg {
    fill: rgb(28 40 48 / 18%);
  }
  .shop-rating__fg {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    display: inline-flex;
    gap: 0.06rem;
    overflow: hidden;
    white-space: nowrap;
  }
  .shop-rating__fg svg {
    fill: var(--rar-accent);
    flex: 0 0 auto;
  }
  .shop-rating__text strong {
    color: var(--rar-heading);
  }
  a.shop-rating:hover .shop-rating__text {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
{% endstylesheet %}
